<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude internal databases (SQLCipher encrypted & plain receipts/vault databases) -->
        <exclude domain="database" path="."/>

        <!-- Exclude SharedPreferences storing Keystore-encrypted database passphrases and biometric credentials -->
        <exclude domain="sharedpref" path="papertrail_database_passphrase_prefs.xml"/>
        <exclude domain="sharedpref" path="securevault_database_passphrase_prefs.xml"/>
        <exclude domain="sharedpref" path="securevault_system_integrity_prefs.xml"/>

        <!-- Exclude SecureVault encrypted blob files and internal receipts in files directory -->
        <exclude domain="file" path="securevault"/>
        <exclude domain="file" path="receipts"/>
        <exclude domain="file" path="securevault_meta_shadow.json"/>
        <exclude domain="root" path="no_backup/securevault_meta_shadow.json"/>

        <!-- Exclude app-specific external storage SecureVault directory -->
        <exclude domain="external" path="securevault"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude internal databases from device-to-device migration -->
        <exclude domain="database" path="."/>

        <!-- Exclude SharedPreferences storing Keystore-encrypted database passphrases and biometric credentials -->
        <exclude domain="sharedpref" path="papertrail_database_passphrase_prefs.xml"/>
        <exclude domain="sharedpref" path="securevault_database_passphrase_prefs.xml"/>
        <exclude domain="sharedpref" path="securevault_system_integrity_prefs.xml"/>

        <!-- Exclude SecureVault encrypted blob files and receipts from device-to-device migration -->
        <exclude domain="file" path="securevault"/>
        <exclude domain="file" path="receipts"/>
        <exclude domain="file" path="securevault_meta_shadow.json"/>
        <exclude domain="root" path="no_backup/securevault_meta_shadow.json"/>

        <!-- Exclude app-specific external storage SecureVault directory -->
        <exclude domain="external" path="securevault"/>
    </device-transfer>
</data-extraction-rules>
