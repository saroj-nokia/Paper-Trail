<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude internal databases (SQLCipher encrypted & plain receipts/vault databases) -->
        <exclude domain="database" path="."/>

        <!-- Exclude EncryptedSharedPreferences storing database master keys, passphrases, and biometric tracker -->
        <exclude domain="sharedpref" path="papertrail_secure_vault_prefs.xml"/>
        <exclude domain="sharedpref" path="papertrail_secure_vault_prefs_fallback.xml"/>
        <exclude domain="sharedpref" path="securevault_encrypted_prefs.xml"/>
        <exclude domain="sharedpref" path="securevault_encrypted_prefs_fallback.xml"/>
        <exclude domain="sharedpref" path="securevault_system_integrity.xml"/>
        <exclude domain="sharedpref" path="securevault_system_integrity_fallback.xml"/>

        <!-- Exclude SecureVault encrypted blob files and internal receipts in files directory -->
        <exclude domain="file" path="securevault"/>
        <exclude domain="file" path="receipts"/>

        <!-- Exclude app-specific external storage SecureVault directory -->
        <exclude domain="external" path="securevault"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude internal databases from device-to-device migration -->
        <exclude domain="database" path="."/>

        <!-- Exclude EncryptedSharedPreferences from device-to-device migration -->
        <exclude domain="sharedpref" path="papertrail_secure_vault_prefs.xml"/>
        <exclude domain="sharedpref" path="papertrail_secure_vault_prefs_fallback.xml"/>
        <exclude domain="sharedpref" path="securevault_encrypted_prefs.xml"/>
        <exclude domain="sharedpref" path="securevault_encrypted_prefs_fallback.xml"/>
        <exclude domain="sharedpref" path="securevault_system_integrity.xml"/>
        <exclude domain="sharedpref" path="securevault_system_integrity_fallback.xml"/>

        <!-- Exclude SecureVault encrypted blob files and receipts from device-to-device migration -->
        <exclude domain="file" path="securevault"/>
        <exclude domain="file" path="receipts"/>

        <!-- Exclude app-specific external storage SecureVault directory -->
        <exclude domain="external" path="securevault"/>
    </device-transfer>
</data-extraction-rules>
